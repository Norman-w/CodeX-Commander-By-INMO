{
  "name": "codex-commander-by-inmo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.1",
  "scripts": {
    "build": "pnpm --filter @codex-commander/protocol build && pnpm --filter @codex-commander/mac-bridge build",
    "dev": "pnpm --filter @codex-commander/mac-bridge dev",
    "generate:codex": "pnpm --filter @codex-commander/mac-bridge generate:codex",
    "test": "pnpm --filter @codex-commander/protocol test && pnpm --filter @codex-commander/mac-bridge test",
    "typecheck": "pnpm --filter @codex-commander/protocol build && pnpm --filter @codex-commander/mac-bridge typecheck",
    "android:assemble": "./scripts/with-local-env.sh ./glasses-app/gradlew -p ./glasses-app assembleDebug",
    "android:test": "./scripts/with-local-env.sh ./glasses-app/gradlew -p ./glasses-app testDebugUnitTest",
    "doctor": "./scripts/doctor.sh",
    "smoke:codex": "pnpm build && pnpm --filter @codex-commander/mac-bridge smoke:codex",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  }
}
