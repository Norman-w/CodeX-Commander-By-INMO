# Copy this file to .env. Never commit the populated .env file.
COMMANDER_HOST=127.0.0.1
COMMANDER_PORT=8787
COMMANDER_APP_SERVER_MODE=gui_shared
# gui_shared: 附着 ChatGPT.app 已运行的 app-server（需打开 ChatGPT 或启用 daemon）
# stdio: Bridge 自 spawn 独立 app-server（开发/无 GUI 时 fallback）
COMMANDER_REALTIME_TRANSPORT=auto
COMMANDER_REALTIME_VOICE=juniper
COMMANDER_APP_SERVER_SOCKET=
COMMANDER_CWD=/absolute/path/to/the/project/codex/should-control
# Leave empty to auto-detect mac-bridge-go/data and mac-bridge-go/media.
COMMANDER_RUNTIME_DIR=
COMMANDER_ORIGIN_ALLOWLIST=
COMMANDER_PAIRING_FILE=./data/pairing.json
COMMANDER_REALTIME_IDLE_MS=60000
# Optional local WAV used by the management page's link-test button.
COMMANDER_PROBE_AUDIO_PATH=
# visor_only（默认）：只在 AIR3 播放；mac_only：只在 Mac 播放；mac_and_visor：Mac 与 AIR3 同时播放
COMMANDER_LOCAL_AUDIO_OUTPUT=visor_only
COMMANDER_CODEX_BIN=codex
# Legacy compatibility setting. The Go Bridge ignores it during startup and
# never creates or resumes a Codex session without an explicit user action.
COMMANDER_THREAD_ID=
# Optional source tag for explicitly created Bridge sessions.
COMMANDER_CONTEXT_BINDING_ID=
# Reconnect the most recently updated Commander-owned task in COMMANDER_CWD.
COMMANDER_AUTO_SELECT_LATEST=true
COMMANDER_TAILSCALE_BIN=tailscale
COMMANDER_CODEX_MODEL=
COMMANDER_APPROVAL_POLICY=on-request
COMMANDER_SANDBOX=workspace-write
COMMANDER_NETWORK_ACCESS=false
COMMANDER_MEDIA_ROOTS=
COMMANDER_LOG_LEVEL=info

# Optional local Android tool paths used by the repository scripts.
# ANDROID_HOME=/absolute/path/to/Android/sdk
# JAVA_HOME=/absolute/path/to/jdk-17
