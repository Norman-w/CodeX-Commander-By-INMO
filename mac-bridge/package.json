{
  "name": "@codex-commander/mac-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm generate:codex && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "generate:codex": "node scripts/generate-codex-types.mjs",
    "start": "node dist/index.js",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "probe:attach": "node scripts/probe-app-server-attach.mjs",
    "probe:realtime": "node scripts/probe-realtime.mjs",
    "probe:realtime-attach": "node scripts/probe-realtime-attach.mjs",
    "probe:visor-ptt": "node scripts/probe-visor-ptt.mjs",
    "test": "vitest run",
    "typecheck": "pnpm generate:codex && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-commander/protocol": "workspace:*",
    "dotenv": "^16.6.1",
    "sharp": "^0.34.3",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
